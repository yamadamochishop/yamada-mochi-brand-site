      "@context": "https://schema.org",
      "@type": "Recipe",
      "name": "ガーリックバター餅",
      "description": "香ばしく焼いた白餅にガーリックバターをたっぷり塗り、もう一度トースターへ。にんにくとバターの香りが広がる簡単アレンジです。",
      "image": "https://www.yamadamochi.com/images/recipes/garlic-butter-mochi.webp",
      "url": "https://www.yamadamochi.com/recipes/garlic-butter-mochi",
      "inLanguage": "ja",
      "author": {
        "@id": "https://www.yamadamochi.com/#organization"
      },
      "publisher": {
        "@id": "https://www.yamadamochi.com/#organization"
      },
      "recipeCategory": "お餅",
      "keywords": "トースター, バター, にんにく",
      "datePublished": "2026-09-11",
      "recipeIngredient": ["プレーン（白餅） 2切れ", "市販のガーリックバター 大さじ1程度"],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "白餅をトースターで3分ほど焼きます。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "表面にガーリックバターをしっかり塗ります。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "再びトースターへ入れ、約2分、表面に軽く焼き色がつくまで焼きます。"
        }
      ]
    }
  },
