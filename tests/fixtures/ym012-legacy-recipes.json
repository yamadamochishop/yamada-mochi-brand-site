      "@context": "https://schema.org",
      "@type": "Recipe",
      "name": "明太子マヨ餅",
      "description": "香ばしく焼いた白餅に明太マヨをのせてもう一度トースターへ。明太子の塩気とマヨネーズのコクがよく合う簡単アレンジです。",
      "image": "https://www.yamadamochi.com/images/recipes/mentaiko-mayo-mochi.webp",
      "url": "https://www.yamadamochi.com/recipes/mentaiko-mayo-mochi",
      "inLanguage": "ja",
      "author": {
        "@id": "https://www.yamadamochi.com/#organization"
      },
      "publisher": {
        "@id": "https://www.yamadamochi.com/#organization"
      },
      "recipeCategory": "お餅",
      "keywords": "トースター, 明太子, マヨネーズ",
      "datePublished": "2026-09-11",
      "recipeIngredient": [
        "プレーン（白餅） 1切れ",
        "明太子 1/4本",
        "マヨネーズ 大さじ1",
        "刻み海苔 適量"
      ],
      "recipeInstructions": [
        {
          "@type": "HowToStep",
          "position": 1,
          "text": "白餅をトースターで軽く焼き色がつくまで焼きます。"
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "text": "明太子とマヨネーズを混ぜます。"
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "text": "焼いた餅の上に明太マヨを塗ります。"
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "text": "再びトースターで約2分焼きます。"
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "text": "好みで刻み海苔をのせます。"
        }
      ]
    }
  },
